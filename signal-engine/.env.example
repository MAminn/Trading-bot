# Copy to .env on the VPS and fill in real values. Never commit .env.

# Set by the Dockerfile and compose; override only if you relocate the artifact
# tree. Host-mounted from /opt/trading-bot/signal-engine/runtime.
ENGINE_BASE_DIR=/app/runtime

# The durable signal outbox (SQLite + WAL sidecars). Its DIRECTORY is
# host-mounted from /opt/trading-bot/signal-engine/state and must persist across
# container recreation: undelivered PREPARED/READY rows live here, and losing
# them would drop execution-critical CLOSE signals.
OUTBOX_DB_PATH=/app/outbox/outbox.db

# Where to POST signals/trades/heartbeats.
APP_API_BASE=https://YOUR_DOMAIN_OR_SERVER_IP

# Bearer for the app's ingest endpoints. MUST be identical to the frontend's
# ENGINE_SERVICE_TOKEN. This is NOT the executor's ENGINE_CREDENTIALS_TOKEN,
# which is a different secret and must stay different.
ENGINE_SERVICE_TOKEN=replace-with-the-frontend-engine-service-token

# Optional. Empty = broadcast: one signal is posted with no user_id and the app
# fans it out to every running client, so a client who signed up minutes ago
# starts receiving the stream with no operator action. Setting it pins every
# post to one client (used for smoke tests).
#
# One engine, one strategy: do NOT run one engine per client. They would
# recompute identical signals.
ENGINE_USER_ID=

# Optional transport tuning.
# INGEST_TIMEOUT=10
# HEARTBEAT_INTERVAL=60

# Optional alert email. Left empty the engine sends no mail — send_email() is a
# no-op without both values. There is no credential default in the engine.
LIVE_EMAIL_ADDRESS=
LIVE_EMAIL_APP_PASSWORD=

# Optional Binance endpoint overrides. Defaults are the public production
# endpoints. The engine uses read-only market-data endpoints only: it holds no
# API key, signs nothing, and places no orders.
# BINANCE_BASE_URL=https://api.binance.com
# BINANCE_FUTURES_BASE_URL=https://fapi.binance.com
