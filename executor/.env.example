# Allowed values: OFF, TESTNET_READ, TESTNET_TRADE, LIVE_READ, LIVE_TRADE
#   OFF           - no Binance connectivity, no trading logic. THE DEFAULT.
#   TESTNET_READ  - testnet, read-only.
#   TESTNET_TRADE - testnet, account enforcement + risk guard + placement.
#   LIVE_READ     - MAINNET, read-only. Cannot place: the client has no write
#                   methods at all.
#   LIVE_TRADE    - MAINNET, REAL MONEY. Requires LIVE_TRADING_ACK and
#                   LIVE_ORDER_CAP_USD below or it refuses to start.
EXECUTION_MODE=OFF

# Testnet-only credentials from https://testnet.binancefuture.com.
# Required for TESTNET_READ / TESTNET_TRADE. Never put live keys here.
BINANCE_TESTNET_API_KEY=
BINANCE_TESTNET_API_SECRET=

# MAINNET credentials — REMOVED FROM THE LIVE PATH. Leave these EMPTY.
#
# LIVE_READ and LIVE_TRADE now sign with the CONNECTED USER's Binance keys:
# the pair the client entered at /app/connect, stored encrypted in Supabase and
# fetched by this executor from the app's credentials endpoint. Nothing in
# main.py reads the two variables below any more — they are not a fallback, and
# a live mode with no connected user keys fails closed rather than using them.
#
# If they are set, the executor logs a warning that they are being ignored and
# should be deleted. The correct key restrictions (enable Futures, disable
# withdrawals, IP-whitelist this host) are now the CLIENT's to set on their own
# Binance account, and should be stated in the connect instructions.
BINANCE_LIVE_API_KEY=
BINANCE_LIVE_API_SECRET=

# LIVE_TRADE will not start unless this is exactly I_UNDERSTAND_REAL_MONEY.
# Leave empty everywhere except a host that is intended to trade real funds.
LIVE_TRADING_ACK=

# LIVE_TRADE will not start unless this is set to a positive number <= 500.
# Absolute per-order notional ceiling in USD, applied on top of every
# config-driven sizing rule and in every sizing mode. Keep this tiny for the
# first live runs. The exchange min notional for ETHUSDT is 20 USDT, so values
# below ~25 will be rejected as "below min notional" after step rounding.
LIVE_ORDER_CAP_USD=

# Optional. Set to 1 to permit sizing_mode=full_capital on mainnet. Leave
# EMPTY for the first live runs: without it, a full_capital config blocks OPENs
# instead of sizing against the whole account.
LIVE_ALLOW_FULL_CAPITAL=

# Optional. Set to 1 to run ONE synthetic OPEN then CLOSE and exit, instead of
# consuming ML signals. Requires a trade-capable mode and a flat position.
# Unset it again after the run.
LIVE_SMOKE_TEST=
# LONG (default) or SHORT — the side of the synthetic smoke order.
LIVE_SMOKE_SIDE=

# App API used by the signal consumer (required in every non-OFF mode).
# Base URL of the Node app, e.g. https://your-app.example.com
APP_API_BASE=
# Bearer token for the app's /api/public/engine/* endpoints (must match the app's ENGINE_SERVICE_TOKEN).
ENGINE_SERVICE_TOKEN=

# OPTIONAL — and normally LEFT EMPTY.
#
# EMPTY = multi-tenant. The executor polls /api/public/engine/users/active and
#         runs an isolated session for every client who has enabled execution.
#         A new client signs up, connects keys and presses Start, and is picked
#         up on the next cycle. No operator action, no restart, no edit here.
#         THIS IS THE PRODUCTION SETTING.
#
# SET   = pinned to one user. The executor runs that client and no other.
#         Useful for a smoke test (which requires it — a synthetic order must
#         name the account it will trade) or a dedicated single-client host.
ENGINE_USER_ID=

# Bearer token for /api/public/engine/credentials — the ONLY endpoint that
# returns decrypted key material. Required in LIVE_READ / LIVE_TRADE.
#
# MUST be a different value from ENGINE_SERVICE_TOKEN. That token is accepted by
# the config, signal and telemetry routes; key material must not sit behind it.
# Both sides enforce this: the app refuses to serve and the executor refuses to
# start if the two are equal. Must match the app's ENGINE_CREDENTIALS_TOKEN.
#
# Generate with: openssl rand -hex 32
ENGINE_CREDENTIALS_TOKEN=

# Optional; one-time recovery/replay cursor (ISO 8601), leave empty normally.
CONSUMER_START_AFTER=
