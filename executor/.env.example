# Allowed values: OFF, TESTNET_READ, TESTNET_TRADE, LIVE_READ, LIVE_TRADE
#   OFF           - no Binance connectivity, no trading logic. THE DEFAULT.
#   TESTNET_READ  - testnet, read-only.
#   TESTNET_TRADE - testnet, account enforcement + risk guard + placement.
#   LIVE_READ     - MAINNET, read-only. Cannot place: the client has no write
#                   methods at all.
#   LIVE_TRADE    - MAINNET, REAL MONEY. Requires LIVE_TRADING_ACK and
#                   LIVE_ORDER_CAP_USD below or it refuses to start.
EXECUTION_MODE=OFF

# Testnet-only credentials from https://testnet.binancefuture.com.
# Required for TESTNET_READ / TESTNET_TRADE. Never put live keys here.
BINANCE_TESTNET_API_KEY=
BINANCE_TESTNET_API_SECRET=

# MAINNET credentials. Required for LIVE_READ / LIVE_TRADE, ignored otherwise.
# Deliberately separate variables so a testnet key can never reach mainnet.
# Recommended key restrictions: enable Futures, disable withdrawals, and
# IP-whitelist the executor host.
BINANCE_LIVE_API_KEY=
BINANCE_LIVE_API_SECRET=

# LIVE_TRADE will not start unless this is exactly I_UNDERSTAND_REAL_MONEY.
# Leave empty everywhere except a host that is intended to trade real funds.
LIVE_TRADING_ACK=

# LIVE_TRADE will not start unless this is set to a positive number <= 500.
# Absolute per-order notional ceiling in USD, applied on top of every
# config-driven sizing rule and in every sizing mode. Keep this tiny for the
# first live runs. The exchange min notional for ETHUSDT is 20 USDT, so values
# below ~25 will be rejected as "below min notional" after step rounding.
LIVE_ORDER_CAP_USD=

# Optional. Set to 1 to permit sizing_mode=full_capital on mainnet. Leave
# EMPTY for the first live runs: without it, a full_capital config blocks OPENs
# instead of sizing against the whole account.
LIVE_ALLOW_FULL_CAPITAL=

# Optional. Set to 1 to run ONE synthetic OPEN then CLOSE and exit, instead of
# consuming ML signals. Requires a trade-capable mode and a flat position.
# Unset it again after the run.
LIVE_SMOKE_TEST=
# LONG (default) or SHORT — the side of the synthetic smoke order.
LIVE_SMOKE_SIDE=

# App API used by the signal consumer (required in every non-OFF mode).
# Base URL of the Node app, e.g. https://your-app.example.com
APP_API_BASE=
# Bearer token for the app's /api/public/engine/* endpoints (must match the app's ENGINE_SERVICE_TOKEN).
ENGINE_SERVICE_TOKEN=
# UUID of the user whose signals this executor consumes.
ENGINE_USER_ID=

# Optional; one-time recovery/replay cursor (ISO 8601), leave empty normally.
CONSUMER_START_AFTER=
